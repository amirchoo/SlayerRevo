--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local CombatConfig = require(ReplicatedStorage.Shared.Config.CombatConfig)
local HealthService = require(script.HealthService)
local DataService = require(script.DataService)
local AvatarService = require(script.AvatarService)
local SkillService = require(script.SkillService)
local ProgressionService = require(script.ProgressionService)
local StaminaService = require(script.StaminaService)
local ManaService = require(script.ManaService)
local InventoryService = require(script.InventoryService)
local DashService = require(script.DashService)
local TownBuilder = require(script.TownBuilder)
local WeaponService = require(script.WeaponService)
local BlockService = require(script.BlockService)
local BowService = require(script.BowService)
local GreatswordService = require(script.GreatswordService)
local EnemyService = require(script.EnemyService)
local TrainingGround = require(script.TrainingGround)
local ArmorService = require(script.ArmorService)
local StaffService = require(script.StaffService)
local TestChest = require(script.TestChest)
local NpcService = require(script.NpcService)
local StarterService = require(script.StarterService)

HealthService.start()
AvatarService.start() -- everyone gets the blocky body armor is made for
DataService.start() -- first: the services below apply each player's save once it loads
StaminaService.start()
ManaService.start()
InventoryService.start()
DashService.start() -- before BlockService: a dodged hit isn't a blocked one
TownBuilder.build()
WeaponService.start()
WeaponService.give(CombatConfig.Sword)
BlockService.start()
BowService.start()
GreatswordService.start()
WeaponService.give(CombatConfig.Mace)
WeaponService.give(CombatConfig.Spear)
WeaponService.give(CombatConfig.Axe)
WeaponService.give(CombatConfig.Emberfang)
StaffService.start()
EnemyService.start()
TrainingGround.build()
ArmorService.start() -- after BlockService (armor reduces what gets through a block) and the town (the stand stands on it)
TestChest.build() -- after the training ground (it stands in it)
NpcService.start() -- after the town (they stand on it)
StarterService.start()
SkillService.start()
ProgressionService.start()
