HealthService.start()
AvatarService.start() -- everyone gets the blocky body armor is made for
DataService.start() -- first: the services below apply each player's save once it loads
StaminaService.start()
ManaService.start()
InventoryService.start()
DashService.start() -- before BlockService: a dodged hit isn't a blocked one
LightingSetup.apply()
TownBuilder.build()
task.spawn(WorldBuilder.build) -- the forest and ruins around the hub; yields as it goes
WeaponService.start()
WeaponService.give(CombatConfig.Sword)
BlockService.start()
BowService.start()
SingleShotService.start(CombatConfig.Crossbow)
SingleShotService.start(CombatConfig.Blunderbuss)
GreatswordService.start()
WeaponService.give(CombatConfig.Mace)
WeaponService.give(CombatConfig.Spear)
WeaponService.give(CombatConfig.Rapier)
WeaponService.give(CombatConfig.Dagger)
WeaponService.give(CombatConfig.Axe)
WeaponService.give(CombatConfig.DualBlade)
WeaponService.give(CombatConfig.Scythe)
WeaponService.give(CombatConfig.Hammer)
WeaponService.give(CombatConfig.Emberfang)
StaffService.start()
EnemyService.start()
MaterialService.start()
LootService.start()
AnimalService.start() -- cows and chickens (and the tame ones in town); their meat drops through LootService
TrainingGround.build()
BossService.start() -- after enemies and blocking (its fights use both)
DungeonService.start() -- the lair's cave mouth, and each run's copy of the dungeon
ArmorService.start() -- after BlockService (armor reduces what gets through a block)
ShieldService.start()
BuffService.start() -- after armor and blocking (its damage negation comes last)
TestChest.build() -- after the training ground (it stands in it)
task.spawn(TrainingStands.build) -- after the training ground and armor; making mannequins yields
task.spawn(ClassHall.build) -- the new-player intro's statues (stand mannequins)
NpcService.start() -- after the town (they stand on it)
PetService.start() -- after the town (Bonnie the cat sits on it)
VillagerService.start() -- after the town (they walk on it)
CookingService.start() -- the campfire's Cook prompt
LeaderboardService.start() -- the trophy board by the guild
StarterService.start()
TutorialService.start() -- after StarterService (a new player's pick starts their training)
CurrencyService.start()
ConsumableService.start()
ShopService.start()
SkillService.start()
ProgressionService.start()
QuestService.start()
MapService.start()
AdminService.start() -- admin test tools (Studio, or the game's owner)
