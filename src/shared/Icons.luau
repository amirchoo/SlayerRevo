--!strict
-- HUD icons: game-icons.net icons (CC BY 3.0, see assets/icons/icons.json for credits) on one
-- uploaded atlas image. Code names icons ("Swords", "Helmet", "Fire", ...); IconAtlas
-- (generated by tools/icon_atlas.py) says where each one sits on the atlas.
-- Icons are white with a dark outline, so ImageColor3 tints them.

local IconAtlas = require(script.Parent.IconAtlas)

local Icons = {}

Icons.IMAGE = "rbxassetid://112301804387715" -- assets/icons/atlas.png, uploaded

function Icons.has(name: string?): boolean
	return name ~= nil and IconAtlas.Cells[name] ~= nil
end

-- Points `label` at icon `name` (blank if there's no such icon).
function Icons.set(label: ImageLabel, name: string?)
	local cell = if name then IconAtlas.Cells[name] else nil
	if cell then
		label.Image = Icons.IMAGE
		label.ImageRectOffset = cell
		label.ImageRectSize = Vector2.new(IconAtlas.CellSize, IconAtlas.CellSize)
	else
		label.Image = ""
	end
end

-- A square ImageLabel showing icon `name`, filling `parent` (inset by `inset` pixels per side).
function Icons.image(parent: Instance, name: string?, inset: number?): ImageLabel
	local label = Instance.new("ImageLabel")
	label.Name = "Icon"
	label.BackgroundTransparency = 1
	label.AnchorPoint = Vector2.new(0.5, 0.5)
	label.Position = UDim2.fromScale(0.5, 0.5)
	local pad = (inset or 0) * 2
	label.Size = UDim2.new(1, -pad, 1, -pad)
	label.ScaleType = Enum.ScaleType.Fit
	Icons.set(label, name)
	label.Parent = parent
	return label
end

return Icons
